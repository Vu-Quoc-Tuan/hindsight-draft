# Optional server-side grounded narrative renderer (ADR-0024).
# When configured, the LLM selects read-only tools and authors the final grounded message.
# Leave any value empty to use deterministic fallback only.
# Allowed protocols: OPENAI_COMPATIBLE, OLLAMA.
AI_PROVIDER_PROTOCOL=OPENAI_COMPATIBLE
AI_BASE_URL=https://your-openai-compatible-provider.example/v1
AI_API_KEY=
AI_MODEL=your-model-id
AI_COHESION_TIMEOUT_SECONDS=60
# DEV-ONLY probe: show raw cohesion provider prose without grounding validation.
# Never enable this in production; bypass results are not persisted to the cache.
NOCPRO_BYPASS_COHESION_GROUNDING=false
# Dev-only inspection switch for raw provider prose across Advisor, Assistant,
# and Cohesion. Refused when APP_ENV/ENVIRONMENT is production.
NOCPRO_BYPASS_GROUNDING=false

# These credentials belong only to the API service. Never create VITE_AI_*
# variables because Vite values are embedded in browser assets.

# Path on the host machine to raw datasets (alarm_data.csv, topoIP.csv, etc.)
# Useful for production deployment outside the git runner workspace.
# Leave empty or unset in local development to default to ../nocpro-mock/datasets/raw.
# HINDSIGHT_DATA_DIR=/srv/hindsight/data
# Run deterministic Deep Dive -> Counterfactual -> quality evaluation in background.
NOCPRO_AUTO_CHAIN_QUALITY=true
# Keep Deep Dive and Counterfactual CPU work serialized by default so API
# requests stay responsive while a whole snapshot is evaluated.
TIER2_MAX_WORKERS=1
# Keep deterministic background evaluation responsive for interactive API use.
NOCPRO_COUNTERFACTUAL_MAX_WORKERS=1
# Bound concurrent lifecycle upserts below the SQLAlchemy connection-pool cap.
NOCPRO_ANALYSIS_PERSISTENCE_CONCURRENCY=4
